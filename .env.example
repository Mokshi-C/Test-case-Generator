# TestTeller local configuration
# Copy this file to .env and fill in only the provider you want to use.
# Never commit your real .env file.

# Choose one: gemini, openai, claude, llama
LLM_PROVIDER=gemini

# Gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Claude
CLAUDE_API_KEY=your_anthropic_claude_api_key_here

# Optional GitHub token for private repository ingestion
GITHUB_TOKEN=your_github_token_here

# ChromaDB local mode
CHROMA_DB_USE_REMOTE=false
CHROMA_DB_PERSIST_DIRECTORY=./chroma_data
DEFAULT_COLLECTION_NAME=test_collection

# Output defaults
TEST_OUTPUT_FORMAT=md
OUTPUT_FILE_PATH=testteller_generated_tests/testteller-testcases.md

# Automation defaults
AUTOMATION_LANGUAGE=python
AUTOMATION_FRAMEWORK=pytest
AUTOMATION_OUTPUT_DIR=./testteller_automated_tests
